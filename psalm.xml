<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    runTaintAnalysis="true"
>
    <projectFiles>
        <directory name="src" />
        <directory name="demo/src" />
        <ignoreFiles>
            <!-- Files with optional dependencies (Qiq, Twig, Ray\MediaQuery, BEAR.Sunday Router) -->
            <file name="demo/src/Resource/App/Safe/HtmlEscaped.php"/>
            <file name="demo/src/Resource/App/Safe/QiqEscapedEcho.php"/>
            <file name="demo/src/Resource/App/Safe/TwigEscaped.php"/>
            <file name="demo/src/Resource/App/Safe/SqlPrepared.php"/>
            <file name="demo/src/Resource/App/Safe/JsonRendererEcho.php"/>
            <file name="demo/src/Bootstrap.php"/>
            <file name="demo/src/Injector.php"/>
            <directory name="demo/src/Module"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="stubs/PDO.phpstub"/>
        <file name="stubs/AuraSql.phpstub"/>
        <file name="stubs/Qiq.phpstub"/>
    </stubs>
    <plugins>
        <pluginClass class="BEAR\Security\Psalm\ResourceTaintPlugin"/>
    </plugins>
    <issueHandlers>
        <!-- Demo code suppressions -->
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="demo"/>
            </errorLevel>
        </PropertyNotSetInConstructor>
        <NonInvariantDocblockPropertyType>
            <errorLevel type="suppress">
                <directory name="demo"/>
            </errorLevel>
        </NonInvariantDocblockPropertyType>
        <!-- PHP 8.3+ feature, not required for PHP 8.1 minimum -->
        <MissingOverrideAttribute errorLevel="suppress" />
        <!-- Pattern strings are validated at runtime -->
        <ArgumentTypeCoercion>
            <errorLevel type="suppress">
                <referencedFunction name="preg_match" />
                <referencedFunction name="preg_match_all" />
            </errorLevel>
        </ArgumentTypeCoercion>
        <!-- Callable type is validated -->
        <MixedPropertyTypeCoercion errorLevel="suppress" />
        <!-- HTTP response header is always set after file_get_contents -->
        <RedundantCondition>
            <errorLevel type="suppress">
                <file name="src/Dast/DastScanner.php" />
            </errorLevel>
        </RedundantCondition>
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <file name="src/Dast/DastScanner.php" />
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
        <RiskyTruthyFalsyComparison errorLevel="suppress" />
        <MixedAssignment>
            <errorLevel type="suppress">
                <file name="src/Analyzer/ComposerAuditScanner.php" />
            </errorLevel>
        </MixedAssignment>
        <MixedArgumentTypeCoercion>
            <errorLevel type="suppress">
                <file name="src/Analyzer/ComposerAuditScanner.php" />
            </errorLevel>
        </MixedArgumentTypeCoercion>
        <RedundantPropertyInitializationCheck>
            <errorLevel type="suppress">
                <file name="src/Dast/SecurityTest.php" />
            </errorLevel>
        </RedundantPropertyInitializationCheck>
        <!-- Score calculation with int/float division -->
        <InvalidOperand>
            <errorLevel type="suppress">
                <file name="src/Report/SecurityChecklistReport.php" />
            </errorLevel>
        </InvalidOperand>
    </issueHandlers>
</psalm>
