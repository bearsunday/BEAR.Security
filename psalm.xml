<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <!-- Depends on bear/app-meta which is optional -->
            <file name="src/Dast/EndpointDiscovery.php"/>
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="stubs/PDO.phpstub"/>
        <file name="stubs/AuraSql.phpstub"/>
        <file name="stubs/Qiq.phpstub"/>
    </stubs>
    <plugins>
        <pluginClass class="BEAR\Security\Psalm\ResourceTaintPlugin"/>
    </plugins>
    <issueHandlers>
        <!-- PHP 8.3+ feature, not required for PHP 8.1 minimum -->
        <MissingOverrideAttribute errorLevel="suppress" />
        <!-- Pattern strings are validated at runtime -->
        <ArgumentTypeCoercion>
            <errorLevel type="suppress">
                <referencedFunction name="preg_match" />
                <referencedFunction name="preg_match_all" />
                <file name="demo/src/Bootstrap.php" />
            </errorLevel>
        </ArgumentTypeCoercion>
        <!-- Callable type is validated -->
        <MixedPropertyTypeCoercion errorLevel="suppress" />
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <file name="src/Dast/DastScanner.php" />
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
        <RiskyTruthyFalsyComparison errorLevel="suppress" />
        <MixedAssignment>
            <errorLevel type="suppress">
                <file name="src/Analyzer/ComposerAuditScanner.php" />
                <file name="src/Ai/ClaudeAuditor.php" />
                <file name="src/Dast/AutoDastScanner.php" />
            </errorLevel>
        </MixedAssignment>
        <MixedArgumentTypeCoercion>
            <errorLevel type="suppress">
                <file name="src/Analyzer/ComposerAuditScanner.php" />
            </errorLevel>
        </MixedArgumentTypeCoercion>
        <MixedPropertyFetch>
            <errorLevel type="suppress">
                <file name="src/Dast/AutoDastScanner.php" />
            </errorLevel>
        </MixedPropertyFetch>
        <MixedArgument>
            <errorLevel type="suppress">
                <file name="src/Dast/AutoDastScanner.php" />
            </errorLevel>
        </MixedArgument>
        <RedundantPropertyInitializationCheck>
            <errorLevel type="suppress">
                <file name="src/Dast/SecurityTest.php" />
            </errorLevel>
        </RedundantPropertyInitializationCheck>
        <!-- Score calculation with int/float division -->
        <InvalidOperand>
            <errorLevel type="suppress">
                <file name="src/Report/SecurityChecklistReport.php" />
                <file name="src/Ai/TokenTracker.php" />
            </errorLevel>
        </InvalidOperand>
        <!-- CLI adapter uses shell_exec for claude CLI detection -->
        <ForbiddenCode>
            <errorLevel type="suppress">
                <file name="src/Ai/ClaudeCliAdapter.php" />
                <!-- Intentional for the demo; exec() is the vulnerability being demonstrated -->
                <file name="demo/src/Resource/App/Vulnerable/ShellInjection.php" />
            </errorLevel>
        </ForbiddenCode>
        <!-- Psalm plugin classes -->
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Psalm" />
            </errorLevel>
        </ClassMustBeFinal>
        <InternalClass>
            <errorLevel type="suppress">
                <directory name="src/Psalm" />
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="src/Psalm" />
            </errorLevel>
        </InternalMethod>
        <RedundantCondition>
            <errorLevel type="suppress">
                <file name="src/Dast/DastScanner.php" />
                <file name="src/Psalm/ResourceTaintPlugin.php" />
            </errorLevel>
        </RedundantCondition>
        <!--
            Demo app (demo/src): illustrates patterns, some depending on packages that are only
            suggested (twig/twig, ray/media-query), not installed. Psalm 7 is stricter than Psalm 6
            about the resulting mixed/undefined types here; none of this affects taint analysis,
            which is checked by tests/Psalm/AuraSqlTaintTest.php and .github/workflows/taint-analysis.yml.
        -->
        <UndefinedClass>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </UndefinedClass>
        <MixedArrayAssignment>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MixedArrayAssignment>
        <MixedReturnTypeCoercion>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MixedReturnTypeCoercion>
        <MixedFunctionCall>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MixedFunctionCall>
        <MixedMethodCall>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MixedMethodCall>
        <InvalidArgument>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </InvalidArgument>
        <MixedReturnStatement>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MixedReturnStatement>
        <NonInvariantPropertyType>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </NonInvariantPropertyType>
        <NonInvariantDocblockPropertyType>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </NonInvariantDocblockPropertyType>
        <OverriddenPropertyAccess>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </OverriddenPropertyAccess>
        <MissingConstructor>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </MissingConstructor>
        <PossiblyFalseArgument>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </PossiblyFalseArgument>
        <PossiblyFalseOperand>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </PossiblyFalseOperand>
        <PossiblyFalseReference>
            <errorLevel type="suppress">
                <directory name="demo/src" />
            </errorLevel>
        </PossiblyFalseReference>
    </issueHandlers>
</psalm>
